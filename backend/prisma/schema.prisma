generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model Match {
    id          Int      @id @default(autoincrement())
    homeTeam    String
    awayTeam    String
    competition String
    date        DateTime
    venue       String
    score       String

    lineups     Lineup[]
}

model Lineup {
    id Int @id @default(autoincrement())

    matchId  Int
    playerId Int

    team String

    shirtNumber Int?
    position    String?

    starter Boolean @default(true)
    minuteIn  Int?
    minuteOut Int?

    match  Match  @relation(fields: [matchId], references: [id])
    player Player @relation(fields: [playerId], references: [id])

    @@unique([matchId, playerId])
}

model Player {
    id        Int    @id @default(autoincrement())
    firstName String
    lastName  String
    slug      String @unique

    lineups   Lineup[]
}
