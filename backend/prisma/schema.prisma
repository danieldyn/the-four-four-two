generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Match {
    id                  Int      @id @default(autoincrement())

    homeTeam            String
    homePrimaryColour   String?
    homeSecondaryColour String?

    awayTeam            String
    awayPrimaryColour   String?
    awaySecondaryColour String?

    competition         String
    date                DateTime
    venue               String
    score               String

    lineups             Lineup[]
}

model Lineup {
    id          Int @id @default(autoincrement())

    matchId     Int
    playerId    Int

    team        String

    shirtNumber Int
    position    String

    starter     Boolean @default(true)
    minuteIn    Int?
    minuteOut   Int?

    isCaptain   Boolean @default(false)
    goalsScored Int @default(0)

    match  Match  @relation(fields: [matchId], references: [id])
    player Player @relation(fields: [playerId], references: [id])

    @@unique([matchId, playerId])
}

model Player {
    id        Int    @id @default(autoincrement())
    firstName String
    lastName  String
    slug      String @unique
    alias     String?
    display   String?

    lineups   Lineup[]
}
