        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "nodemon": "^3.0.0",
        "prisma": "^5.0.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
